{
  "name": "sephora-lens-prototype",
  "workspaces": ["frontend", "backend"], 
  "scripts": {
    "dev-frontend": "npm run dev --prefix frontend",
    "dev-backend": "npm run dev --prefix backend",
    "dev-bq-backend": "npm run dev-server --prefix frontend",
    "dev": "concurrently \"npm run dev-frontend\" \"npm run dev-backend\" \"npm run dev-bq-backend\""
  },
  "devDependencies": {
    "concurrently": "latest"
  }
}
